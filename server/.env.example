# Set secrets only in the hosting provider's environment settings. Never commit real keys.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=

# Mainland China / Qwen (enable with AI_PROVIDER=qwen)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Shared service settings
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=
MAX_VIDEO_MB=200

# Optional OSS for Qwen video uploads larger than 7 MB
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
